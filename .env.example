# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Perplexity API (используется для автопроверки обоснований в Части 1 и эссе в Части 3)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Google Sheets: путь к JSON-файлу сервис-аккаунта и ID таблицы
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
# Или (для облачного хостинга без доступа к файлу) вставить весь JSON-ключ одной строкой:
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type": "service_account", ...}
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Results

# Текст дедлайна, показывается в /start (просто строка, ни на что не влияет)
ASSESSMENT_DEADLINE=

LLM_CONCURRENCY=5
